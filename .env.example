# Freshservice MCP Server – Environment Variables
# Copy this file to .env and fill in your values (never commit .env!)

# Your Freshservice domain (without https://)
FRESHSERVICE_DOMAIN=yourcompany.freshservice.com

# Your personal API key from Profile Settings
FRESHSERVICE_API_KEY=your-api-key-here

# Optional: set to "true" to disable all write operations
# FRESHSERVICE_READONLY=false
