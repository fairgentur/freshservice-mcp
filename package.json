{
  "name": "freshservice-mcp",
  "version": "0.4.0",
  "description": "MCP server for Freshservice – manage tickets, changes, agents and conversations from any MCP-compatible AI client",
  "keywords": [
    "mcp",
    "freshservice",
    "freshworks",
    "itsm",
    "helpdesk",
    "tickets",
    "model-context-protocol"
  ],
  "author": "Patrick Gebhardt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fairgentur/freshservice-mcp.git"
  },
  "homepage": "https://github.com/fairgentur/freshservice-mcp#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "freshservice-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node'",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build -- --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
